# =============================================================
# Unity generated / local — should never be committed
# =============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated project files (regenerated by Unity)
/[Aa]ssembly-CSharp*.csproj
/*.csproj
/*.sln
/*.unityproj
/*.user
/*.pidb
/*.booproj
/*.svd
/*.suo

# Visual Studio / Rider / IDE
/.vs/
/.vscode/
/.idea/
*.userprefs

# Plastic SCM (Unity Version Control) workspace metadata
/.plastic/
/*.plastic

# Unity crash / build reports
/[Cc]rashlytics/
sysinfo.txt
*.stackdump
crashlytics-build.properties

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# TextMesh Pro package demo content (re-importable; not project art)
/[Aa]ssets/TextMesh Pro/Examples & Extras/
/[Aa]ssets/TextMesh Pro/Examples & Extras.meta
